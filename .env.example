# Copy to `.env` (which docker compose loads automatically) and fill in real values.
# These names are the canonical ones from docs/deployment.md and must match the
# `api_key_env` / `secret_env` / `client_secret_env` values in your config TOML.
# Robinauts reads only the variables its config file names -- there is no fixed key.

# Model provider keys (the anthropic + openai SDKs are both wired in).
ROBINAUTS_ANTHROPIC_KEY=
ROBINAUTS_OPENAI_KEY=

# Optional, only if your config declares them:
# ROBINAUTS_OPENROUTER_KEY=      # an openai-compatible provider
# ROBINAUTS_GITHUB_TOKEN=        # an mcp_servers.* tool secret_env
# ROBINAUTS_GOOGLE_SECRET=       # a sign-in provider client_secret_env
